{
  "name": "dunu-app",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "verify:db": "tsx scripts/verify-node.ts",
    "verify": "npm run typecheck && npm run verify:db",
    "deploy": "npm run build:web && npx vercel deploy --prod dist --yes"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/noto-naskh-arabic": "^0.4.5",
    "@expo-google-fonts/public-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "expo": "~57.0.22",
    "expo-auth-session": "~57.0.12",
    "expo-av": "~16.0.8",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "~19.2.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
